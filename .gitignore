# =============================================================================
# DATASET SAFETY -- read this before touching this file.
#
# The PNG (Pulmonary Nodule Growth) dataset lives in data/external/png/. It
# is ~1,536 NIfTI volumes of patient data collected under a hospital ethics
# approval (see docs/datasets.md). It must NEVER be committed: it is not
# ours to redistribute. The *.nii / *.nii.gz rules below are what actually
# prevent this even if the folder location changes -- do not weaken them.
# =============================================================================

# --- the PNG dataset: ignored in full ---
# Not just the volumes -- patient-characteristics.csv carries per-patient
# age/sex, characteristics.csv per-nodule measurements, and NGP3T.json the
# manifest tying them together. All of it is patient data.
data/external/

# --- LDCT-IQAC dataset: images ignored, JSON score labels kept ---
# data/training/image/ and data/testing/images/ hold the LDCT-IQAC CT
# images themselves (TIFF, patient-derived) -- never commit these. The
# *.tif/*.tiff rules below already block the files; the path rules here
# make the intent explicit even if the extension changes. train.json/
# test.json contain only filename -> quality-score pairs (no pixel data)
# and are small/useful for reproducibility, so they're explicitly kept.
data/training/image/**
data/testing/images/**
!data/training/train.json
!data/testing/test.json

# --- derived and working data ---
data/raw/**
data/interim/**
data/processed/**
data/testing/**
!data/**/.gitkeep
!data/README.md
!data/testing/test.json

# Other conventional dataset locations, kept even though unused today, in
# case this project or a fork of it grows one.
datasets/**
archive/**
!datasets/**/.gitkeep
!archive/**/.gitkeep

# --- medical-image and archive formats, wherever they appear ---
*.dcm
*.dicom
*.nii
*.nii.gz
*.mhd
*.raw
*.tif
*.tiff
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.gz

# --- model checkpoints / weights / generated predictions ---
*.ckpt
*.pth
*.pt
*.h5
*.hdf5
*.pb
*.onnx
*.safetensors
*.npy
*.npz
checkpoints/
outputs/

# --- TensorBoard / training logs / caches ---
logs/
*.tfevents.*
.cache/

# =============================================================================
# EXPLICIT ALLOW-LIST -- small, intentionally-committed images stay committable.
# =============================================================================
!docs/**/*.jpg
!docs/**/*.png
!tests/fixtures/**

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.venv/
venv/
env/
.benchmarks/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
